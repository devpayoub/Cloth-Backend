# Medusa backend — copy to .env and adjust.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Project-local Postgres (scripts/db.mjs — no Docker needed):
#   pnpm db:setup && pnpm db
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa-cloth

# Or use the docker-compose.yml service, or any managed Postgres.
# STOREFRONT_ORIGIN=http://localhost:3000
